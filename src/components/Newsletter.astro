<section class="newsBlock container-page" aria-labelledby="nl-title">
  <div>
    <p class="kicker">每周一封</p>
    <h2 id="nl-title">一周里最好的，收进一封邮件</h2>
    <p class="lede">新插件、用例和合集。一周一封。就这样。</p>
  </div>
  <form class="newsForm" action="#newsletter" method="get" id="newsletter">
    <label class="sr-only" for="nl-email" style="position:absolute;left:-9999px">邮箱</label>
    <input id="nl-email" name="email" type="email" required placeholder="you@example.com" autocomplete="email" />
    <button class="btn-accent" type="submit">订阅</button>
    <p class="newsNote">界面演示，不会向任何邮件服务商提交。一周一封。我们拿它做什么，见<a href="/privacy/">隐私</a>。▪ 这是一份目录，不是账号系统。</p>
  </form>
</section>

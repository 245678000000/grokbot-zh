---
import Base from '../../layouts/Base.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';
import Attribution from '../../components/Attribution.astro';
import { plugins, pluginBySlug } from '../../lib/data';

export function getStaticPaths() {
  return plugins.map((p: any) => ({ params: { slug: p.slug } }));
}

const p = pluginBySlug(Astro.params.slug);
if (!p) throw new Error('missing plugin');
const author = p.author || {};
const title = p.name;
const hue = (title.split('').reduce((acc: number, c: string) => acc + c.charCodeAt(0), 0) % 360);
const iconBg = `hsl(${hue}, 20%, 30%)`;
---
<Base title={p.name} description={p.tagline_zh || p.tagline}>
  <p class="crumb"><a href="/">首页</a> / <a href="/plugins/">插件</a> / {p.name}</p>

  <article class="detailHeroCard">
    <div class="detailHeroTop">
      <div class="detailAvatar" style={`background: ${iconBg};`}>
        <span>{title.slice(0, 1).toUpperCase()}</span>
      </div>
      <div class="detailHeadInfo">
        <span class="kicker">插件{p.featured ? ' · 精选' : ''}</span>
        <h1 class="detailTitle">{p.name}</h1>
        <p class="detailTagline">{p.tagline_zh || p.tagline}</p>
      </div>
    </div>
    <div class="detailMetaBar">
      <div class="detailTags">
        <span class="chip">{p.category_zh || p.category}</span>
        {p.project_url && <a class="btn-ghost" href={p.project_url} target="_blank" rel="noopener" style="font-size:0.75rem;min-block-size:28px">官方项目</a>}
        {p.repo_url && <a class="btn-ghost" href={p.repo_url} target="_blank" rel="noopener" style="font-size:0.75rem;min-block-size:28px">代码仓库</a>}
      </div>
      {author.handle && (
        <div class="authorRow">
          <span>作者:</span>
          {author.url ? (
            <a class="authorPill" href={author.url} target="_blank" rel="noopener">@{author.handle}</a>
          ) : (
            <span class="authorPill">@{author.handle}</span>
          )}
        </div>
      )}
    </div>
  </article>

  {p.description_zh && (
    <div class="detailSection">
      <h2>插件说明</h2>
      <MarkdownContent content={p.description_zh} lang="zh-CN" />
    </div>
  )}

  {p.install_steps?.length > 0 && (
    <div class="detailSection">
      <h2>怎么安装与接入</h2>
      <ol class="steps">
        {p.install_steps.map((s: string, i: number) => (
          <li><span class="n">{i + 1}</span><span>{s}</span></li>
        ))}
      </ol>
    </div>
  )}

  {p.prompt && (
    <div class="detailSection">
      <div class="promptHeader">
        <h2>提示词（原文，可直接复制使用）</h2>
        <button class="btn-ghost btn-copy" data-copy={p.prompt}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          <span>复制提示词</span>
        </button>
      </div>
      <pre class="promptBox">{p.prompt}</pre>
    </div>
  )}

  <Attribution authorHandle={author.handle} authorUrl={author.url} origUrl={p.url} />

  <script is:inline>
    document.querySelectorAll('.btn-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (text) {
          await navigator.clipboard.writeText(text);
          const span = btn.querySelector('span');
          if (span) span.textContent = '已复制！';
          setTimeout(() => {
            if (span) span.textContent = '复制提示词';
          }, 2000);
        }
      });
    });
  </script>
</Base>


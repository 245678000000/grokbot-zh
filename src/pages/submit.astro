---
import Base from '../layouts/Base.astro';
---
<Base title="投稿" description="向 Grok Bot 中文目录提交机器人、插件、用例或公开线索。">
  <section class="submitHero">
    <p class="crumb"><a href="/">首页</a><span>/</span>投稿</p>
    <div class="submitHero__grid">
      <div>
        <h1>把好东西，<br /><span>收进中文目录。</span></h1>
      </div>
      <div class="submitHero__intro">
        <p>你做的机器人、真正有用的插件，或者你在公开社区里发现的好用例，都可以从这里开始。</p>
        <p class="submitHero__note">先讲清它能做什么。不需要写广告。</p>
      </div>
    </div>
  </section>

  <section class="submitWorkspace" aria-label="中文目录投稿工作台">
    <form class="submitForm" id="submissionForm">
      <div class="formHead">
        <h2>填写投稿卡片</h2>
        <span class="localBadge">本地生成，不上传</span>
      </div>

      <fieldset class="typePicker">
        <legend>你要提交什么？</legend>
        <label><input type="radio" name="type" value="机器人" checked /><span>机器人</span></label>
        <label><input type="radio" name="type" value="插件" /><span>插件</span></label>
        <label><input type="radio" name="type" value="用例" /><span>用例</span></label>
        <label><input type="radio" name="type" value="公开线索" /><span>公开线索</span></label>
      </fieldset>

      <div class="fieldGrid">
        <label class="field">
          <span>名称 <b>*</b></span>
          <input name="name" id="submissionName" required maxlength="80" placeholder="例如：每周研究摘要 Bot" />
        </label>
        <label class="field">
          <span>公开链接 <b>*</b></span>
          <input name="url" id="submissionUrl" type="url" required placeholder="https://" />
        </label>
      </div>

      <label class="field">
        <span>一句话说明 <b>*</b></span>
        <input name="summary" required maxlength="140" placeholder="它为谁解决了什么问题？" />
        <small>别写“强大”“颠覆”。写一个可以核验的具体结果。</small>
      </label>

      <label class="field">
        <span>为什么值得收录？ <b>*</b></span>
        <textarea name="reason" required rows="5" maxlength="800" placeholder="最好包含：实际使用场景、已经完成的结果、必要的配置或限制。"></textarea>
      </label>

      <div class="fieldGrid">
        <label class="field">
          <span>你与它的关系</span>
          <select name="relationship">
            <option value="我是作者">我是作者</option>
            <option value="我在公开网络上发现的">我在公开网络上发现的</option>
            <option value="我是使用者">我是使用者</option>
          </select>
        </label>
        <label class="field">
          <span>联系方式 <em>可选</em></span>
          <input name="contact" maxlength="120" placeholder="邮箱、GitHub 或 X 账号" />
        </label>
      </div>

      <label class="confirmRow">
        <input name="publicConfirm" type="checkbox" required />
        <span>我确认这个链接公开可访问，且投稿中没有密钥、私人对话、付费内容或其他敏感资料。</span>
      </label>

      <div class="formActions">
        <button class="btn-accent submitButton" type="submit">生成投稿卡片 <span aria-hidden="true">→</span></button>
        <p>当前站点为静态目录：这一步不会自动上传，只会在你的浏览器中生成可交付的投稿文件。</p>
      </div>
    </form>

    <aside class="reviewDocket" aria-label="收录规则">
      <div class="docketHead"><span>收录流程</span><span id="docketType">机器人</span></div>
      <div class="docketTitle">
        <span>本次投稿</span>
        <strong id="docketName">待填写</strong>
        <small id="docketUrl">公开链接将显示在这里</small>
      </div>
      <ol class="reviewSteps">
        <li><span>01</span><div><strong>来源核验</strong><p>链接可访问，作者与用途说得清。</p></div></li>
        <li><span>02</span><div><strong>实用性判断</strong><p>条目是否解决真问题，而不是只有宣传语。</p></div></li>
        <li><span>03</span><div><strong>中文整理</strong><p>保留原作者与原始链接，补齐中文摘要。</p></div></li>
        <li><span>04</span><div><strong>入库</strong><p>通过后进入对应分类和搜索索引。</p></div></li>
      </ol>
      <div class="rejectNote">
        <strong>不收录</strong>
        <p>无法核验的说法、纯导流页、伪装成工具的广告，以及要求公开密钥或私人数据的条目。</p>
      </div>
    </aside>
  </section>

  <section class="submissionResult" id="submissionResult" hidden aria-live="polite">
    <div class="resultHead">
      <h2>投稿卡片已生成</h2>
      <span id="resultStatus">尚未上传</span>
    </div>
    <textarea id="submissionOutput" readonly aria-label="生成的投稿卡片"></textarea>
    <div class="resultActions">
      <button class="btn-accent" id="copySubmission" type="button">复制内容</button>
      <button class="btn-ghost" id="downloadSubmission" type="button">下载 .md 文件</button>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('submissionForm');
    const result = document.getElementById('submissionResult');
    const output = document.getElementById('submissionOutput');
    const copyButton = document.getElementById('copySubmission');
    const downloadButton = document.getElementById('downloadSubmission');
    const status = document.getElementById('resultStatus');
    const docketName = document.getElementById('docketName');
    const docketUrl = document.getElementById('docketUrl');
    const docketType = document.getElementById('docketType');

    const updateDocket = () => {
      if (!form) return;
      const data = new FormData(form);
      if (docketName) docketName.textContent = data.get('name') || '待填写';
      if (docketUrl) docketUrl.textContent = data.get('url') || '公开链接将显示在这里';
      if (docketType) docketType.textContent = data.get('type') || '机器人';
    };

    form?.addEventListener('input', updateDocket);
    form?.addEventListener('change', updateDocket);

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const today = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long' }).format(new Date());
      const markdown = `# Grok Bot 中文目录投稿\n\n- 类型：${data.get('type')}\n- 名称：${data.get('name')}\n- 公开链接：${data.get('url')}\n- 与条目的关系：${data.get('relationship')}\n- 联系方式：${data.get('contact') || '未提供'}\n- 生成日期：${today}\n\n## 一句话说明\n\n${data.get('summary')}\n\n## 为什么值得收录\n\n${data.get('reason')}\n\n## 公开性确认\n\n已确认链接公开可访问，且投稿不含密钥、私人对话、付费内容或其他敏感资料。\n`;
      output.value = markdown;
      result.hidden = false;
      status.textContent = '尚未上传';
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    copyButton?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(output.value);
        status.textContent = '已复制';
      } catch {
        output.select();
        document.execCommand('copy');
        status.textContent = '已复制';
      }
    });

    downloadButton?.addEventListener('click', () => {
      const blob = new Blob([output.value], { type: 'text/markdown;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const anchor = document.createElement('a');
      anchor.href = url;
      anchor.download = `grokbot-zh-submission-${new Date().toISOString().slice(0, 10)}.md`;
      anchor.click();
      URL.revokeObjectURL(url);
      status.textContent = '已下载';
    });
  </script>
</Base>

<style>
  .submitHero {
    overflow: hidden;
    margin-bottom: 1.25rem;
    padding: clamp(1.75rem, 3.5vw, 3.25rem);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(40rem 26rem at 6% 4%, rgba(93, 91, 168, 0.22), transparent 68%),
      radial-gradient(28rem 22rem at 98% 96%, rgba(176, 105, 60, 0.10), transparent 72%),
      #1A1816;
    color: #F7F4EE;
  }
  .submitHero .crumb { margin: 0 0 clamp(2rem, 4vw, 3.25rem); color: #9C958A; }
  .submitHero .crumb span { color: #6B655C; }
  .submitHero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, 0.85fr); gap: 3rem; align-items: end; }
  .submitHero h1 { max-width: 13ch; margin: 0; color: #F7F4EE; font-size: clamp(2.3rem, 4.2vw, 3.5rem); line-height: 1.16; letter-spacing: -0.028em; }
  .submitHero h1 span { white-space: nowrap; }
  .submitHero__intro { max-width: 32rem; color: #C4BDB1; font-size: 1rem; line-height: 1.85; }
  .submitHero__intro p { margin: 0; }
  .submitHero__note { margin-top: 1.25rem !important; padding-top: 1.25rem; border-top: 1px solid rgba(217, 179, 131, 0.28); color: #A79E90; font-size: 0.8rem; line-height: 1.7; }

  .submitWorkspace { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.7fr); gap: 1.25rem; align-items: start; }
  .submitForm, .reviewDocket, .submissionResult { border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); }
  .submitForm { padding: clamp(1.4rem, 3vw, 2.4rem); }
  .formHead, .resultHead { display: flex; justify-content: space-between; gap: 1rem; align-items: center; margin-bottom: 1.75rem; }
  .formHead h2, .resultHead h2 { margin: 0; font-size: clamp(1.35rem, 2.2vw, 1.75rem); }
  .localBadge { flex: none; padding: 0.3rem 0.7rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-muted); font-size: 0.72rem; }
  .typePicker { margin: 0 0 1.75rem; padding: 0; border: 0; }
  .typePicker legend { margin-bottom: 0.7rem; font-size: var(--text-sm); font-weight: 600; }
  .typePicker label { display: inline-block; margin: 0 0.35rem 0.4rem 0; }
  .typePicker input { position: absolute; opacity: 0; pointer-events: none; }
  .typePicker span { display: inline-flex; align-items: center; min-height: 38px; padding: 0 0.9rem; border: 1px solid var(--color-border); border-radius: 9px; color: var(--color-text-muted); font-size: var(--text-sm); cursor: pointer; }
  .typePicker input:checked + span { border-color: rgba(var(--accent-rgb), 0.3); background: var(--color-accent-tint); color: var(--color-accent-text); }
  .typePicker input:focus-visible + span { outline: 2px solid var(--color-focus); outline-offset: 2px; }
  .fieldGrid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .field { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.2rem; color: var(--color-text); font-size: var(--text-sm); font-weight: 600; }
  .field b { color: var(--color-danger); }
  .field em { color: var(--color-text-muted); font-size: var(--text-xs); font-style: normal; font-weight: 400; }
  .field input, .field select, .field textarea { width: 100%; border: 1px solid var(--color-border-interactive); border-radius: 10px; background: var(--color-surface-raised); color: var(--color-text); font-size: var(--text-sm); font-weight: 400; }
  .field input, .field select { min-height: 48px; padding: 0 0.85rem; }
  .field textarea { resize: vertical; min-height: 130px; padding: 0.8rem 0.85rem; line-height: 1.65; }
  .field input:focus, .field select:focus, .field textarea:focus { outline: 0; border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), 0.12); }
  .field small { color: var(--color-text-muted); font-size: 0.72rem; font-weight: 400; line-height: 1.7; }
  .confirmRow { display: flex; gap: 0.75rem; align-items: flex-start; margin: 0.5rem 0 1.5rem; padding: 1rem; border-radius: var(--radius-md); background: var(--color-surface-raised); color: var(--color-text-muted); font-size: var(--text-xs); line-height: 1.75; cursor: pointer; }
  .confirmRow input { flex: none; width: 16px; height: 16px; margin-top: 0.15rem; accent-color: var(--color-accent); }
  .formActions { display: flex; align-items: center; gap: 1.25rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .submitButton { min-height: 44px; border-radius: 10px; }
  .formActions p { max-width: 33rem; margin: 0; color: var(--color-text-muted); font-size: 0.74rem; line-height: 1.7; }

  .reviewDocket { position: sticky; top: 5.25rem; overflow: hidden; padding: 1.1rem; }
  .docketHead { display: flex; justify-content: space-between; gap: 1rem; padding: 0.35rem 0.25rem 1rem; border-bottom: 1px solid var(--color-border); color: var(--color-text-muted); font-size: 0.76rem; }
  .docketHead span:last-child { color: var(--color-accent-text); }
  .docketTitle { padding: 1.5rem 0.25rem; border-bottom: 1px solid var(--color-border); }
  .docketTitle > span { color: var(--color-text-muted); font-size: 0.74rem; }
  .docketTitle strong { display: block; overflow: hidden; margin: 0.45rem 0 0.25rem; font-size: 1.25rem; text-overflow: ellipsis; white-space: nowrap; }
  .docketTitle small { display: block; overflow: hidden; color: var(--color-text-muted); font-size: 0.7rem; text-overflow: ellipsis; white-space: nowrap; }
  .reviewSteps { list-style: none; margin: 0; padding: 0.5rem 0; }
  .reviewSteps li { display: grid; grid-template-columns: 1.75rem minmax(0, 1fr); gap: 0.6rem; padding: 0.9rem 0.25rem; border-bottom: 1px solid var(--color-border); }
  .reviewSteps li > span { color: var(--color-text-muted); font-family: var(--font-mono); font-size: 0.66rem; }
  .reviewSteps strong { font-size: var(--text-sm); }
  .reviewSteps p, .rejectNote p { margin: 0.35rem 0 0; color: var(--color-text-muted); font-size: 0.74rem; line-height: 1.7; }
  .rejectNote { margin-top: 0.75rem; padding: 1rem; border-radius: 10px; background: var(--color-surface-raised); }
  .rejectNote strong { color: var(--color-danger); font-size: var(--text-xs); }

  .submissionResult { margin-top: 1.25rem; padding: clamp(1.4rem, 3vw, 2.4rem); scroll-margin-top: 6rem; }
  .submissionResult[hidden] { display: none; }
  .resultHead { margin-bottom: 1.25rem; }
  .resultHead span { flex: none; color: var(--color-warn); font-size: var(--text-xs); }
  .submissionResult textarea { width: 100%; min-height: 320px; resize: vertical; padding: 1rem; border: 1px solid var(--color-border); border-radius: 10px; background: #1A1816; color: #E6E1D8; font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.7; }
  .resultActions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }

  @media (max-width: 900px) {
    .submitHero__grid, .submitWorkspace { grid-template-columns: minmax(0, 1fr); }
    .reviewDocket { position: static; }
  }
  @media (max-width: 620px) {
    .submitHero { padding: 1.5rem 1.25rem 2rem; border-radius: 20px; }
    .submitHero .crumb { margin-bottom: 2.5rem; }
    .submitHero__grid { gap: 1.75rem; }
    .submitHero h1 { font-size: clamp(2rem, 10vw, 2.7rem); }
    .fieldGrid { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .formHead, .formActions, .resultHead { align-items: flex-start; flex-direction: column; }
    .submitButton { width: 100%; }
  }
</style>

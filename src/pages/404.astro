---
import Base from '../layouts/Base.astro';
---
<Base title="没有这一页" description="中文目录里找不到这个地址。" canonical={false}>
  <div class="container-page page404">
    <p class="kicker">404</p>
    <h1>没有这一页</h1>
    <p class="lede">地址不在这份中文目录里。可能是拼写，也可能原站还没译过来。</p>
    <p>
      <a class="btn-accent" href="/">回首页</a>
      <a class="btn-ghost" href="/marketplace/" style="margin-left:0.5rem">可分享机器人</a>
      <a class="btn-ghost" href="https://grokbot.dev/" style="margin-left:0.5rem">grokbot.dev 原文</a>
    </p>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import Attribution from '../../components/Attribution.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';
import { templates, templateBySlug } from '../../lib/data';

export function getStaticPaths() {
  return templates.map((t: any) => ({ params: { slug: t.slug } }));
}

const t = templateBySlug(Astro.params.slug);
if (!t) throw new Error('missing template');
const author = t.sharer || t.author || {};

const rawTags = t.tags_zh || t.tags || [];
const tags = rawTags.map((x: any) => (typeof x === 'object' && x !== null ? x.zh || x.name || x.en : x));

const title = t.name_zh || t.name;
const hue = (title.split('').reduce((acc: number, c: string) => acc + c.charCodeAt(0), 0) % 360);
const iconBg = `hsl(${hue}, 20%, 30%)`;
---
<Base title={title} description={t.tagline_zh || t.tagline}>
  <p class="crumb"><a href="/">首页</a> / <a href="/bots/">机器人</a> / {t.name}</p>

  <article class="detailHeroCard">
    <div class="detailHeroTop">
      <div class="detailAvatar" style={`background: ${iconBg};`}>
        <span>{title.slice(0, 1).toUpperCase()}</span>
      </div>
      <div class="detailHeadInfo">
        <span class="kicker">可分享机器人</span>
        <h1 class="detailTitle">{t.name}</h1>
        <p class="detailTagline">{t.tagline_zh || t.tagline}</p>
      </div>
      {t.share_url && (
        <a class="btn-accent detailInstallBtn" href={t.share_url} target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>在 Grok 中安装</span>
        </a>
      )}
    </div>

    <div class="detailMetaBar">
      <div class="detailTags">
        {tags.map((x: string) => <span class="chip">{x}</span>)}
      </div>
      {author.handle && (
        <div class="authorRow">
          <span>分享者:</span>
          {author.url ? (
            <a class="authorPill" href={author.url} target="_blank" rel="noopener">
              @{author.handle}
            </a>
          ) : (
            <span class="authorPill">@{author.handle}</span>
          )}
        </div>
      )}
    </div>
  </article>

  {t.description_zh && (
    <div class="detailSection">
      <h2>功能简介</h2>
      <MarkdownContent content={t.description_zh} lang="zh-CN" />
    </div>
  )}

  {t.body && (
    <div class="detailSection">
      <div class="promptHeader">
        <h2>原文说明与配置</h2>
        <button class="btn-ghost btn-copy" data-copy={t.body}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
          <span>复制配置</span>
        </button>
      </div>
      <MarkdownContent content={t.body} lang="en" />
    </div>
  )}

  <div style="margin: 1.5rem 0;">
    <a class="moreLink" href={t.url}>查看原站条目与更新记录 →</a>
  </div>

  <Attribution authorHandle={author.handle} authorUrl={author.url} origUrl={t.url} />

  <script is:inline>
    document.querySelectorAll('.btn-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy');
        if (text) {
          await navigator.clipboard.writeText(text);
          const span = btn.querySelector('span');
          if (span) span.textContent = '已复制！';
          setTimeout(() => {
            if (span) span.textContent = '复制配置';
          }, 2000);
        }
      });
    });
  </script>
</Base>

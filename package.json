{
  "name": "grokbot-zh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Grok Bot 中文目录 — independent Simplified Chinese localization of grokbot.dev",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prebuild": "python3 scripts/localize.py",
    "dev": "python3 scripts/localize.py && astro dev --host 0.0.0.0 --port 4380",
    "build": "python3 scripts/localize.py && astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4380",
    "localize": "python3 scripts/localize.py"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.2.8",
    "astro": "^5.13.0",
    "micromark": "^4.0.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
